  {% if ROBOT_SOFTWARE_VERSION >= v5.21.0 %}
    {% if ROBOT_SOFTWARE_VERSION < v6.0.0 %}
  optimovel(target, a = a, v = v, r = r)
    {% elif ROBOT_SOFTWARE_VERSION >= v10.8.0 %}
